new file mode 100644
index 0000000..a6cc1dd
--- /dev/null
+++ b/lib/roles.ts
@@ -0,0 +1,12 @@
+// Role names with special meaning. Safe to import anywhere (no DB access).
+
+// The top role. Always has every page and every action, can't be edited on
+// /permissions, and is the only role that can manage users, roles and
+// permissions. (The old "Admin" role is renamed to this by the migration.)
+// Every other role — including any role named "Admin" — is a normal role
+// configured on /permissions.
+export const SUPER_ROLE_NAME = "Manager";
+
+export function isSuperRoleName(roleName: string | null | undefined): boolean {
+  return roleName?.toLowerCase() === SUPER_ROLE_NAME.toLowerCase();
+}
diff --git a/migration-manager-actions.sql b/migration-manager-actions.sql
new file mode 100644
index 0000000..d6eb407
--- /dev/null
+++ b/migration-manager-actions.sql
@@ -0,0 +1,45 @@
+-- Manager role + action permissions
+-- Run with: docker exec -it wms-db psql -U postgres -d wms_v2
+-- Run this BEFORE deploying the new code: the new code only treats
+-- "Manager" as the top role, so Admin users need to be Manager already.
+-- Check first:  SELECT id, name FROM roles ORDER BY id;
+
+BEGIN;
+
+-- 1. Rename Admin -> Manager (the top role).
+--    If a "Manager" role already exists, its users stay, Admin's users move
+--    into it, and the old Admin role is removed. Either way every former
+--    Admin user ends up on Manager.
+DO $$
+DECLARE
+  admin_id   int;
+  manager_id int;
+BEGIN
+  SELECT id INTO admin_id   FROM roles WHERE lower(name) = 'admin';
+  SELECT id INTO manager_id FROM roles WHERE lower(name) = 'manager';
+
+  IF admin_id IS NOT NULL AND manager_id IS NULL THEN
+    UPDATE roles SET name = 'Manager' WHERE id = admin_id;
+  ELSIF admin_id IS NOT NULL AND manager_id IS NOT NULL THEN
+    UPDATE users SET role_id = manager_id WHERE role_id = admin_id;
+    DELETE FROM roles WHERE id = admin_id;  -- its permission rows cascade
+  END IF;
+
+  -- Manager always has everything; any page grants it had are meaningless.
+  DELETE FROM role_page_permissions
+   WHERE role_id = (SELECT id FROM roles WHERE lower(name) = 'manager');
+END $$;
+
+-- 2. Per-role action permissions (e.g. 'so.create', 'scan.inbound').
+CREATE TABLE IF NOT EXISTS role_action_permissions (
+  id serial PRIMARY KEY,
+  role_id integer NOT NULL REFERENCES roles(id) ON DELETE CASCADE,
+  action_key text NOT NULL,
+  created_at timestamp NOT NULL DEFAULT now()
+);
+CREATE UNIQUE INDEX IF NOT EXISTS role_action_permissions_role_action_idx
+  ON role_action_permissions (role_id, action_key);
+
+COMMIT;
+
+-- Verify:  SELECT r.name, count(u.id) FROM roles r LEFT JOIN users u ON u.role_id = r.id GROUP BY r.name;
